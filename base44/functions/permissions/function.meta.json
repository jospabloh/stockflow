      "purpose": "changeUserRole (ver handlers/changeUserRole.ts)",
      "callers": [
        "src/components/settings/TeamMembersManager.jsx"
      ]
    },
    "getTeamMembers": {
      "purpose": "getTeamMembers (ver handlers/getTeamMembers.ts)",
