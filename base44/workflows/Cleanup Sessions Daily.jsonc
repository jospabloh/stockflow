{
  "name": "Cleanup Sessions Daily",
  "description": "Revoca Session (active/passive) con last_seen > 30 días. Corre 02:30 CDMX (08:30 UTC).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 8 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "cleanup_sessions_daily",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "jobs",
            "args": {
              "action": "cleanupSessions"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}
