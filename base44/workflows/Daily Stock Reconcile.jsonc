{
  "name": "Daily Stock Reconcile",
  "description": "Reporte diario de SOLO LECTURA: movimientos de los últimos 2 días con stock_applied != true. No corrige nada. Corre 08:30 CDMX (14:30 UTC).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 14 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_stock_reconcile",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "jobs",
            "args": {
              "action": "dailyStockReconcile"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}
