{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "address": {
      "description": "Direcci\u00f3n",
      "type": "string"
    },
    "business_id": {
      "description": "ID del negocio al que pertenece",
      "type": "string"
    },
    "contact_name": {
      "description": "Nombre del contacto",
      "type": "string"
    },
    "email": {
      "description": "Correo electr\u00f3nico",
      "type": "string"
    },
    "extra_contacts": {
      "default": "[]",
      "description": "Contactos adicionales (JSON: [{name, email, phone}])",
      "type": "string"
    },
    "name": {
      "description": "Nombre del proveedor",
      "type": "string"
    },
    "notes": {
      "description": "Notas adicionales",
      "type": "string"
    },
    "phone": {
      "description": "Tel\u00e9fono",
      "type": "string"
    },
    "rfc": {
      "description": "RFC del proveedor",
      "type": "string"
    }
  },
  "required": [
    "name",
    "business_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": { "user_condition": { "role": "admin" } }
  }
}