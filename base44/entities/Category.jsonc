{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la categor\u00eda"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n de la categor\u00eda"
    },
    "color": {
      "type": "string",
      "description": "Color representativo (hex)"
    },
    "wholesale_min_qty": {
      "type": "number",
      "description": "Cantidad m\u00ednima por categor\u00eda para activar precio mayoreo (0 o vac\u00edo = no configurado)"
    },
    "business_id": {
      "type": "string",
      "description": "ID del negocio al que pertenece"
    }
  },
  "required": [
    "name",
    "business_id"
  ],
  "rls": {
    "create": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "read": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "update": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "delete": {
      "data.business_id": "{{user.data.business_id}}"
    }
  }
}