{
  "name": "Category",
  "type": "object",
  "properties": {
    "business_id": {
      "description": "ID del negocio al que pertenece",
      "type": "string"
    },
    "color": {
      "description": "Color representativo (hex)",
      "type": "string"
    },
    "description": {
      "description": "Descripci\u00f3n de la categor\u00eda",
      "type": "string"
    },
    "name": {
      "description": "Nombre de la categor\u00eda",
      "type": "string"
    },
    "wholesale_min_qty": {
      "description": "Cantidad m\u00ednima por categor\u00eda para activar precio mayoreo (0 o vac\u00edo = no configurado)",
      "type": "number"
    }
  },
  "required": [
    "name",
    "business_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}