{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la categor\u00eda"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n de la categor\u00eda"
    },
    "color": {
      "type": "string",
      "description": "Color representativo (hex)"
    },
    "business_id": {
      "type": "string",
      "description": "ID del negocio al que pertenece"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "business_id": "{{user.business_id}}"
    },
    "read": {
      "business_id": "{{user.business_id}}"
    },
    "update": {
      "business_id": "{{user.business_id}}"
    },
    "delete": {
      "business_id": "{{user.business_id}}"
    }
  }
}