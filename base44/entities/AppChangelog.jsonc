{
  "name": "AppChangelog",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "N\u00famero de versi\u00f3n (ej: 2.12.0)"
    },
    "released_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de liberaci\u00f3n de la versi\u00f3n"
    },
    "notes": {
      "type": "string",
      "description": "Notas del changelog para esta versi\u00f3n"
    },
    "synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp en que el cron registr\u00f3 esta entrada"
    },
    "source": {
      "type": "string",
      "enum": [
        "cron",
        "manual"
      ],
      "default": "cron",
      "description": "Origen del registro: cron autom\u00e1tico o entrada manual"
    }
  },
  "required": [
    "version"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}