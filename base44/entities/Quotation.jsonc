{
  "name": "Quotation",
  "type": "object",
  "properties": {
    "amount_paid": {
      "default": 0,
      "description": "Suma total de todos los pagos registrados (campo cacheado)",
      "type": "number"
    },
    "balance": {
      "default": 0,
      "description": "Saldo pendiente: total - amount_paid (campo cacheado)",
      "type": "number"
    },
    "business_id": {
      "description": "ID del negocio al que pertenece",
      "type": "string"
    },
    "cancellation_reason": {
      "description": "Raz\u00f3n o motivo de cancelaci\u00f3n",
      "type": "string"
    },
    "client_email": {
      "description": "Email del cliente",
      "type": "string"
    },
    "client_id": {
      "description": "ID del cliente vinculado",
      "type": "string"
    },
    "client_name": {
      "description": "Nombre del cliente",
      "type": "string"
    },
    "client_phone": {
      "description": "Tel\u00e9fono del cliente",
      "type": "string"
    },
    "delivered": {
      "default": false,
      "description": "Pedido entregado al cliente",
      "type": "boolean"
    },
    "folio": {
      "description": "N\u00famero de folio",
      "type": "string"
    },
    "in_route": {
      "default": false,
      "description": "Pedido en ruta de entrega",
      "type": "boolean"
    },
    "invoice_number": {
      "description": "Número de la factura (individual o consolidada) a la que quedó asignada esta cotización",
      "type": "string"
    },
    "invoice_status": {
      "description": "Estado de facturaci\u00f3n",
      "enum": [
        "pendiente",
        "emitida",
        "no_requerida"
      ],
      "type": "string"
    },
    "items": {
      "description": "Productos de la cotizaci\u00f3n",
      "items": {
        "properties": {
          "is_on_demand": {
            "default": false,
            "description": "true si es un producto bajo pedido que no existe en el cat\u00e1logo",
            "type": "boolean"
          },
          "on_demand_status": {
            "description": "Estado del item bajo pedido: pending | product_created",
            "type": "string"
          },
          "product_description": {
            "description": "Especificaciones o descripci\u00f3n del producto bajo pedido",
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "supplier_id": {
            "description": "ID del proveedor sugerido para este producto bajo pedido (opcional)",
            "type": "string"
          },
          "supplier_name": {
            "description": "Nombre del proveedor (desnormalizado para display)",
            "type": "string"
          },
          "tax_rate": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "notes": {
      "description": "Notas o condiciones",
      "type": "string"
    },
    "paid": {
      "default": false,
      "description": "Pago recibido efectivamente (balance <= 0)",
      "type": "boolean"
    },
    "payment_method": {
      "description": "Forma de pago",
      "type": "string"
    },
    "payments": {
      "default": [],
      "description": "Historial de pagos registrados contra esta cotizaci\u00f3n",
      "items": {
        "properties": {
          "amount": {
            "description": "Monto del pago",
            "type": "number"
          },
          "id": {
            "description": "UUID \u00fanico del pago",
            "type": "string"
          },
          "notes": {
            "description": "Notas opcionales del pago",
            "type": "string"
          },
          "paid_at": {
            "description": "Fecha y hora del pago (ISO)",
            "type": "string"
          },
          "payment_method": {
            "description": "Forma de pago (snapshot)",
            "type": "string"
          },
          "petty_cash_movement_id": {
            "description": "ID del PettyCashMovement si aplica",
            "type": "string"
          },
          "registered_by": {
            "description": "user_id quien registr\u00f3",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "public_link_enabled": {
      "default": false,
      "type": "boolean"
    },
    "public_token": {
      "description": "Token \u00fanico para enlace p\u00fablico",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "description": "Estado de la cotizaci\u00f3n",
      "enum": [
        "draft",
        "sent",
        "accepted",
        "converted",
        "cancelled"
      ],
      "type": "string"
    },
    "subtotal": {
      "description": "Subtotal",
      "type": "number"
    },
    "tax": {
      "description": "IVA",
      "type": "number"
    },
    "total": {
      "description": "Total",
      "type": "number"
    },
    "valid_until": {
      "description": "Fecha de vigencia",
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "items",
    "business_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}