{
  "name": "PettyCashMovement",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID del negocio al que pertenece"
    },
    "movement_type": {
      "type": "string",
      "enum": [
        "initial_fund",
        "income",
        "expense",
        "adjustment"
      ],
      "description": "Tipo: fondo_inicial, ingreso, egreso, ajuste"
    },
    "amount": {
      "type": "number",
      "description": "Monto del movimiento"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n del movimiento"
    },
    "category": {
      "type": "string",
      "description": "Categor\u00eda del movimiento"
    },
    "movement_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del movimiento"
    },
    "reference": {
      "type": "string",
      "description": "Referencia o folio (opcional)"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales (opcional)"
    },
    "generated_by_system": {
      "type": "boolean",
      "default": false,
      "description": "Indica si fue generado autom\u00e1ticamente por el sistema (no editable manualmente)"
    },
    "origin_type": {
      "type": "string",
      "enum": [
        "quotation",
        "movement",
        "utility"
      ],
      "description": "Tipo de origen: cotizaci\u00f3n, movimiento de inventario directo o movimiento de utilidad"
    },
    "origin_id": {
      "type": "string",
      "description": "ID del registro de origen (quotation.id o movement.id)"
    },
    "payment_method_snapshot": {
      "type": "string",
      "description": "Forma de pago en el momento de la transacci\u00f3n"
    }
  },
  "required": [
    "business_id",
    "movement_type",
    "amount",
    "description",
    "movement_date"
  ],
  "rls": {
    "create": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "read": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "update": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "delete": {
      "data.business_id": "{{user.data.business_id}}"
    }
  }
}