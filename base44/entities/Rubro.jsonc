{
  "name": "Rubro",
  "type": "object",
  "properties": {
    "active": {
      "default": true,
      "description": "Si est\u00e1 disponible para usar",
      "type": "boolean"
    },
    "business_id": {
      "description": "ID del negocio al que pertenece",
      "type": "string"
    },
    "is_system": {
      "default": false,
      "description": "Indica si fue sembrado por el sistema como predeterminado",
      "type": "boolean"
    },
    "kind": {
      "description": "Naturaleza del rubro: ingreso o egreso",
      "enum": [
        "income",
        "expense"
      ],
      "type": "string"
    },
    "name": {
      "description": "Nombre del rubro (ej. Renta, N\u00f3mina, Ventas)",
      "type": "string"
    },
    "pl_treatment": {
      "default": "operating",
      "description": "Tratamiento en el Estado de Resultados: operating=gasto/ingreso operativo manual que cuenta; auto_sales=ya lo captura el motor de ventas; auto_cogs=ya lo cubren COGS/pagos a proveedores; distribution=retiro de utilidad (no es gasto). Evita doble conteo en el m\u00f3dulo Utilidad.",
      "enum": [
        "operating",
        "auto_sales",
        "auto_cogs",
        "distribution"
      ],
      "type": "string"
    }
  },
  "required": [
    "name",
    "kind",
    "business_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}