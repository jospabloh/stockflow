{
  "name": "Rubro",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del rubro (ej. Renta, Nómina, Ventas)"
    },
    "kind": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "description": "Naturaleza del rubro: ingreso o egreso"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Si está disponible para usar"
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "Indica si fue sembrado por el sistema como predeterminado"
    },
    "business_id": {
      "type": "string",
      "description": "ID del negocio al que pertenece"
    }
  },
  "required": [
    "name",
    "kind",
    "business_id"
  ],
  "rls": {
    "create": {
      "$or": [
        { "data.business_id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        { "data.business_id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.business_id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "data.business_id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
