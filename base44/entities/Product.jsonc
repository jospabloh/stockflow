{
  "name": "Product",
  "type": "object",
  "properties": {
    "barcode": {
      "description": "C\u00f3digo de barras",
      "type": "string"
    },
    "business_id": {
      "description": "ID del negocio al que pertenece",
      "type": "string"
    },
    "category": {
      "description": "ID de la categor\u00eda",
      "type": "string"
    },
    "description": {
      "description": "Descripci\u00f3n del producto",
      "type": "string"
    },
    "image_url": {
      "description": "URL de imagen del producto",
      "type": "string"
    },
    "min_stock": {
      "default": 5,
      "description": "Stock m\u00ednimo para alerta",
      "type": "number"
    },
    "name": {
      "description": "Nombre del producto",
      "type": "string"
    },
    "purchase_price": {
      "description": "Precio de compra",
      "type": "number"
    },
    "retail_sale_price": {
      "description": "Precio de venta al menudeo",
      "type": "number"
    },
    "sku": {
      "description": "C\u00f3digo SKU",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "inactive"
      ],
      "type": "string"
    },
    "stock": {
      "default": 0,
      "description": "Existencias actuales",
      "type": "number"
    },
    "supplier": {
      "description": "ID del proveedor",
      "type": "string"
    },
    "tax_rate": {
      "default": 16,
      "description": "Tasa de IVA aplicable al producto (0 o 16%)",
      "enum": [
        0,
        16
      ],
      "type": "number"
    },
    "unit": {
      "default": "pieza",
      "description": "Unidad de medida",
      "enum": [
        "pieza",
        "kg",
        "litro",
        "metro",
        "caja",
        "paquete"
      ],
      "type": "string"
    },
    "wholesale_sale_price": {
      "description": "Precio de venta al mayoreo",
      "type": "number"
    }
  },
  "required": [
    "name",
    "retail_sale_price",
    "business_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}