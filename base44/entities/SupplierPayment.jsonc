{
  "name": "SupplierPayment",
  "type": "object",
  "properties": {
    "affects_petty_cash": {
      "default": false,
      "description": "Si el pago gener\u00f3 un egreso autom\u00e1tico en caja chica",
      "type": "boolean"
    },
    "amount": {
      "description": "Monto pagado",
      "type": "number"
    },
    "business_id": {
      "description": "ID del negocio al que pertenece",
      "type": "string"
    },
    "concept": {
      "description": "Concepto o descripci\u00f3n del pago",
      "type": "string"
    },
    "invoice_status": {
      "description": "Estado de la factura del proveedor (pendiente, recibida, no requerida)",
      "enum": [
        "pendiente",
        "recibida",
        "no_requerida"
      ],
      "type": "string"
    },
    "notes": {
      "description": "Notas adicionales (opcional)",
      "type": "string"
    },
    "payment_date": {
      "description": "Fecha del pago (YYYY-MM-DD)",
      "format": "date",
      "type": "string"
    },
    "payment_method": {
      "description": "Forma de pago (nombre snapshot de PaymentMethod)",
      "type": "string"
    },
    "petty_cash_movement_id": {
      "description": "ID del PettyCashMovement asociado cuando affects_petty_cash=true",
      "type": "string"
    },
    "reference": {
      "description": "Referencia, folio o n\u00famero de transacci\u00f3n (opcional)",
      "type": "string"
    },
    "supplier_id": {
      "description": "ID del proveedor",
      "type": "string"
    },
    "supplier_name": {
      "description": "Nombre del proveedor (desnormalizado al momento del pago)",
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "supplier_id",
    "amount",
    "payment_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}