{
  "name": "InventoryAuditLog",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID del producto afectado"
    },
    "product_name": {
      "type": "string",
      "description": "Nombre del producto (desnormalizado)"
    },
    "business_id": {
      "type": "string",
      "description": "ID del negocio al que pertenece"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "direct_edit",
        "system_correction"
      ],
      "description": "Tipo de evento: edici\u00f3n directa sin movimiento o correcci\u00f3n de auditor\u00eda"
    },
    "stock_before": {
      "type": "number",
      "description": "Stock antes del cambio"
    },
    "stock_after": {
      "type": "number",
      "description": "Stock despu\u00e9s del cambio"
    },
    "notes": {
      "type": "string",
      "description": "Descripci\u00f3n legible del motivo del cambio"
    },
    "performed_by": {
      "type": "string",
      "description": "Email del usuario que realiz\u00f3 el cambio"
    }
  },
  "required": [
    "product_id",
    "business_id",
    "event_type"
  ],
  "rls": {
    "create": {
      "$or": [
        { "data.business_id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "update": {
      "$or": [
        { "data.business_id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "data.business_id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}