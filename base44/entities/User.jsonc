{
  // SECURITY: role/business_id carry FIELD-LEVEL write RLS locking them to
  // role `admin` — the tier the service role evaluates as. Without this lock,
  // ANY authenticated user could call auth.updateMe({role:"admin"}) directly
  // to become platform-wide admin (28 business entities carry an unscoped
  // user_condition:{role:"admin"} RLS branch), or updateMe({business_id:"<any
  // id>"}) to take over any tenant's data without its invite code (the
  // data.business_id RLS branch on those same entities grants full read/write
  // regardless of role). All legitimate changes now flow through the
  // service-role backend functions business:createBusinessSafe (new business
  // owner), business:joinBusinessSafe (invite-code join), and
  // permissions:changeUserRole (promote/demote an existing team member —
  // already service-role, unaffected by this lock).
  //
  // DEPLOY ORDER: deploy createBusinessSafe/joinBusinessSafe FIRST, then this
  // schema. If the lock lands before those functions are live, onboarding
  // silently no-ops (Base44 drops disallowed field writes from the old
  // client-side updateMe calls) and new users get stuck on BusinessSetup.
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "owner",
        "almacenista"
      ],
      "default": "almacenista",
      "description": "Rol del usuario: owner (administrador de SU negocio), almacenista (productos, movimientos, cotizaciones y clientes), admin (reservado a la plataforma: la rama user_condition role:admin de cada RLS no está acotada al negocio)",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "business_id": {
      "type": "string",
      "description": "ID del negocio al que pertenece el usuario",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que el usuario tuvo actividad significativa en la app (actualizado con throttle \u2265 15 min)"
    },
    "last_trial_reactivation_email_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha del \u00faltimo email de reactivaci\u00f3n de trial enviado a este usuario"
    },
    "trial_reactivation_email_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de emails de reactivaci\u00f3n de trial enviados durante este per\u00edodo de prueba"
    }
  },
  "required": []
}