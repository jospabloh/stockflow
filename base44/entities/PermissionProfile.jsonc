{
  "name": "PermissionProfile",
  "type": "object",
  "properties": {
    "business_id": {
      "description": "ID del negocio al que pertenece este perfil",
      "type": "string"
    },
    "permissions": {
      "additionalProperties": true,
      "description": "Objeto con permisos en formato 'M\u00f3dulo:acci\u00f3n' => true/false",
      "type": "object"
    },
    "role_key": {
      "description": "Identificador \u00fanico del rol (admin, almacenista, etc)",
      "type": "string"
    }
  },
  "required": [
    "role_key",
    "business_id"
  ],
  "rls": {
    // SECURITY (module 14, 2026-08-23): create/update/delete are gated to
    // role:admin ONLY — not the usual tenant $or[business_id, role:admin]
    // shape. A bare business_id match would let an almacenista rewrite the
    // very PermissionProfile row that decides what an almacenista may do,
    // undoing every server-side hasPermission() check in module 3 (its
    // second-highest precedence reads this entity). Every real write path
    // already required role:admin at the application layer before this rule
    // existed (upsertPermissionProfile.ts checks user.role !== 'admin' → 403
    // before writing as the caller; every other writer — seed/backfill/
    // changeUserRole/dailyPermissionAudit — writes via asServiceRole, which
    // itself evaluates as role:admin) — so this closes the raw-API bypass
    // without changing any legitimate flow. `read` keeps the tenant branch:
    // an almacenista must still be able to read their own resolved profile
    // for client-side UI gating.
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}