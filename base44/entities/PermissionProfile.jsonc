{
  "name": "PermissionProfile",
  "type": "object",
  "properties": {
    "business_id": {
      "description": "ID del negocio al que pertenece este perfil",
      "type": "string"
    },
    "permissions": {
      "additionalProperties": true,
      "description": "Objeto con permisos en formato 'M\u00f3dulo:acci\u00f3n' => true/false",
      "type": "object"
    },
    "role_key": {
      "description": "Identificador \u00fanico del rol (admin, almacenista, etc)",
      "type": "string"
    }
  },
  "required": [
    "role_key",
    "business_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}