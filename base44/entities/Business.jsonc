{
  "name": "Business",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del negocio"
    },
    "rfc": {
      "type": "string",
      "description": "RFC del negocio"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n"
    },
    "logo_url": {
      "type": "string",
      "description": "URL del logotipo"
    },
    "invite_code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico de invitaci\u00f3n"
    },
    "invite_code_active": {
      "type": "boolean",
      "default": true
    },
    "tax_rate": {
      "type": "number",
      "default": 16
    },
    "currency": {
      "type": "string",
      "default": "MXN"
    },
    "low_stock_email": {
      "type": "string"
    },
    "quotation_footer": {
      "type": "string"
    },
    "primary_color": {
      "type": "string",
      "default": "#4F46E5"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "view_only",
        "suspended",
        "archived"
      ],
      "default": "trial"
    },
    "license_plan": {
      "type": "string",
      "enum": [
        "start",
        "growth",
        "pro"
      ],
      "default": "start"
    },
    "licensed_user_limit": {
      "type": "number",
      "default": 4
    },
    "trial_start_at": {
      "type": "string",
      "format": "date-time"
    },
    "trial_end_at": {
      "type": "string",
      "format": "date-time"
    },
    "license_activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "license_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "payment_reference": {
      "type": "string"
    },
    "activation_notes": {
      "type": "string"
    },
    "activated_by_admin": {
      "type": "string"
    },
    "support_contacted_at": {
      "type": "string",
      "format": "date-time"
    },
    "auto_cash_income_to_petty_cash": {
      "type": "boolean",
      "default": false,
      "description": "Caracter\u00edstica opcional: registrar autom\u00e1ticamente ventas en efectivo cobradas como ingresos en caja chica"
    },
    "auto_renewal": {
      "type": "boolean",
      "default": false,
      "description": "Renovaci\u00f3n autom\u00e1tica de licencia activa"
    },
    "view_only_since": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que el negocio entr\u00f3 en modo solo lectura"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que el negocio fue archivado"
    },
    "scheduled_delete_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha programada de eliminaci\u00f3n permanente del negocio"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        { "id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}