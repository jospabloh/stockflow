{
  "name": "Business",
  "type": "object",
  // SECURITY (module 14, 2026-08-23): the 15 license/status fields below carry
  // FIELD-LEVEL write RLS locking them to role:admin \u2014 same pattern and same
  // reasoning as User.role/business_id above. Without it, the entity-level
  // update rule ({"$or":[{"id":business_id},{role:admin}]}) lets ANY member of
  // the tenant \u2014 almacenista included \u2014 flip their own business back to
  // billing_status:"active", stretch trial_end_at, or raise
  // licensed_user_limit via a raw base44.entities.Business.update() call, no
  // UI required. These fields are supposed to be written ONLY by Mission
  // Control's unified lifecycle cron and this app's own platform-owner-gated
  // licenses/ functions (see "License lifecycle is owned by Mission Control"
  // above) \u2014 both write via asServiceRole, which evaluates as role:admin, so
  // this lock changes nothing for them. General business-profile fields
  // (name, address, logo_url, tax_rate, \u2026) are unaffected and stay editable
  // by the tenant's own admin through the normal update rule.
  "properties": {
    "activated_by_admin": {
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "activation_notes": {
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "address": {
      "description": "Direcci\u00f3n",
      "type": "string"
    },
    "archived_at": {
      "description": "Fecha en que el negocio fue archivado",
      "format": "date-time",
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "auto_cash_income_to_petty_cash": {
      "default": false,
      "description": "Caracter\u00edstica opcional: registrar autom\u00e1ticamente ventas en efectivo cobradas como ingresos en caja chica",
      "type": "boolean"
    },
    "auto_renewal": {
      "default": false,
      "description": "Renovaci\u00f3n autom\u00e1tica de licencia activa",
      "type": "boolean",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "billing_status": {
      "default": "trial",
      "enum": [
        "trial",
        "active",
        "view_only",
        "suspended",
        "archived"
      ],
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "currency": {
      "default": "MXN",
      "type": "string"
    },
    "invite_code": {
      "description": "C\u00f3digo \u00fanico de invitaci\u00f3n",
      "type": "string"
    },
    "invite_code_active": {
      "default": true,
      "type": "boolean"
    },
    "license_activated_at": {
      "format": "date-time",
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "license_expires_at": {
      "format": "date-time",
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "license_plan": {
      "default": "start",
      "enum": [
        "start",
        "growth",
        "pro"
      ],
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "licensed_user_limit": {
      "default": 2,
      "type": "number",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "logo_url": {
      "description": "URL del logotipo",
      "type": "string"
    },
    "low_stock_email": {
      "type": "string"
    },
    "name": {
      "description": "Nombre del negocio",
      "type": "string"
    },
    "payment_reference": {
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "phone": {
      "description": "Tel\u00e9fono",
      "type": "string"
    },
    "primary_color": {
      "default": "#4F46E5",
      "type": "string"
    },
    "quotation_footer": {
      "type": "string"
    },
    "referral_bonus_days": {
      "default": 0,
      "type": "number"
    },
    "referral_code": {
      "description": "C\u00f3digo de referido \u00fanico (REF-XXXXXX)",
      "type": "string"
    },
    "referred_by": {
      "description": "ID del negocio que refiri\u00f3",
      "type": "string"
    },
    "rfc": {
      "description": "RFC del negocio",
      "type": "string"
    },
    "scheduled_delete_at": {
      "description": "Fecha programada de eliminaci\u00f3n permanente del negocio",
      "format": "date-time",
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "suspended"
      ],
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "support_contacted_at": {
      "format": "date-time",
      "type": "string"
    },
    "tax_rate": {
      "default": 16,
      "type": "number"
    },
    "trial_end_at": {
      "format": "date-time",
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "trial_start_at": {
      "format": "date-time",
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "view_only_since": {
      "description": "Fecha en que el negocio entr\u00f3 en modo solo lectura",
      "format": "date-time",
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    // SECURITY (module 14, 2026-08-23): gated to role:admin only, unlike the
    // usual tenant $or shape — deleting the Business row itself has no
    // legitimate end-user path (Settings.jsx's danger zone only deletes the
    // requesting USER, leaving "los datos del negocio permanecerán en el
    // sistema" by design; a full tenant deletion goes through
    // scheduled_delete_at, itself locked above). Any tenant member matching
    // the old {"id":business_id} branch could otherwise delete the whole
    // business row with one raw API call.
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}