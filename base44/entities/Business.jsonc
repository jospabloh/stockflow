{
  "name": "Business",
  "properties": {
    "activated_by_admin": {
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "activation_notes": {
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "address": {
      "description": "Direcci\u00f3n",
      "type": "string"
    },
    "archived_at": {
      "description": "Fecha en que el negocio fue archivado",
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "auto_cash_income_to_petty_cash": {
      "default": false,
      "description": "Caracter\u00edstica opcional: registrar autom\u00e1ticamente ventas en efectivo cobradas como ingresos en caja chica",
      "type": "boolean"
    },
    "auto_renewal": {
      "default": false,
      "description": "Renovaci\u00f3n autom\u00e1tica de licencia activa",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "boolean"
    },
    "billing_status": {
      "default": "trial",
      "enum": [
        "trial",
        "active",
        "view_only",
        "suspended",
        "archived"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "currency": {
      "default": "MXN",
      "type": "string"
    },
    "invite_code": {
      "description": "C\u00f3digo \u00fanico de invitaci\u00f3n",
      "type": "string"
    },
    "invite_code_active": {
      "default": true,
      "type": "boolean"
    },
    "license_activated_at": {
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "license_expires_at": {
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "license_plan": {
      "default": "start",
      "enum": [
        "start",
        "growth",
        "pro"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "licensed_user_limit": {
      "default": 2,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "number"
    },
    "logo_url": {
      "description": "URL del logotipo",
      "type": "string"
    },
    "low_stock_email": {
      "type": "string"
    },
    "name": {
      "description": "Nombre del negocio",
      "type": "string"
    },
    "payment_reference": {
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "phone": {
      "description": "Tel\u00e9fono",
      "type": "string"
    },
    "primary_color": {
      "default": "#4F46E5",
      "type": "string"
    },
    "quotation_footer": {
      "type": "string"
    },
    "referral_bonus_days": {
      "default": 0,
      "type": "number"
    },
    "referral_code": {
      "description": "C\u00f3digo de referido \u00fanico (REF-XXXXXX)",
      "type": "string"
    },
    "referred_by": {
      "description": "ID del negocio que refiri\u00f3",
      "type": "string"
    },
    "rfc": {
      "description": "RFC del negocio",
      "type": "string"
    },
    "scheduled_delete_at": {
      "description": "Fecha programada de eliminaci\u00f3n permanente del negocio",
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "suspended"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "support_contacted_at": {
      "format": "date-time",
      "type": "string"
    },
    "tax_rate": {
      "default": 16,
      "type": "number"
    },
    "tenant_id": {
      "description": "Copia de id del propio negocio. La regla RLS {id: {{user.data.business_id}}} no empareja (devuelve [] / 404 al due\u00f1o), pero una regla sobre data.<campo> s\u00ed; read/update usan data.tenant_id. Toda ruta que cree un Business debe fijarlo = id (service role). Solo plataforma (admin) puede escribirlo: si no, un admin de negocio podr\u00eda apuntarlo a otro negocio y leerlo.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "trial_end_at": {
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "trial_start_at": {
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "view_only_since": {
      "description": "Fecha en que el negocio entr\u00f3 en modo solo lectura",
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "data.tenant_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "data.tenant_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}