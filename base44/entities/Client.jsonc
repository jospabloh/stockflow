{
  "name": "Client",
  "type": "object",
  "properties": {
    "address": {
      "description": "Direcci\u00f3n",
      "type": "string"
    },
    "business_id": {
      "description": "ID del negocio al que pertenece",
      "type": "string"
    },
    "business_name": {
      "description": "Nombre del negocio del cliente",
      "type": "string"
    },
    "email": {
      "description": "Correo electr\u00f3nico",
      "type": "string"
    },
    "force_purchase_all_products": {
      "default": false,
      "description": "Aplicar precio de compra en todos los productos y en cualquier cantidad; suma +20 MXN de transporte por producto",
      "type": "boolean"
    },
    "force_wholesale_all_products": {
      "default": false,
      "description": "Aplicar precio mayoreo en todos los productos y en cualquier cantidad",
      "type": "boolean"
    },
    "force_zero_price": {
      "default": false,
      "description": "Forzar precio $0 en todas las ventas (transferencias internas / muestras). No genera movimiento en caja chica.",
      "type": "boolean"
    },
    "giro": {
      "description": "Giro o actividad comercial del cliente",
      "type": "string"
    },
    "name": {
      "description": "Nombre del cliente",
      "type": "string"
    },
    "notes": {
      "description": "Notas adicionales",
      "type": "string"
    },
    "phone": {
      "description": "Tel\u00e9fono",
      "type": "string"
    },
    "rfc": {
      "description": "RFC del cliente",
      "type": "string"
    },
    "status": {
      "default": "active",
      "description": "Estado del cliente",
      "enum": [
        "active",
        "inactive"
      ],
      "type": "string"
    }
  },
  "required": [
    "name",
    "business_name",
    "phone",
    "business_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": { "user_condition": { "role": "admin" } }
  }
}