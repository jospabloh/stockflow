{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "email": {
      "type": "string",
      "description": "Correo electr\u00f3nico"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n"
    },
    "rfc": {
      "type": "string",
      "description": "RFC del cliente"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Estado del cliente"
    },
    "business_id": {
      "type": "string",
      "description": "ID del negocio al que pertenece"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.business_id": "{{user.business_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "almacenista"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "data.business_id": "{{user.business_id}}"
    },
    "update": {
      "$and": [
        {
          "data.business_id": "{{user.business_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "almacenista"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.business_id": "{{user.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}