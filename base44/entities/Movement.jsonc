{
  "name": "Movement",
  "properties": {
    "business_id": {
      "description": "ID del negocio al que pertenece",
      "type": "string"
    },
    "cost_price": {
      "description": "Precio de compra/costo unitario en el momento del movimiento",
      "type": "number"
    },
    "paid": {
      "default": false,
      "description": "Pago recibido efectivamente (solo aplica a salidas directas sin cotizaci\u00f3n)",
      "type": "boolean"
    },
    "product_id": {
      "description": "ID del producto",
      "type": "string"
    },
    "product_name": {
      "description": "Nombre del producto (desnormalizado)",
      "type": "string"
    },
    "quantity": {
      "description": "Cantidad",
      "type": "number"
    },
    "quotation_id": {
      "description": "ID de cotizaci\u00f3n relacionada",
      "type": "string"
    },
    "reason": {
      "description": "Cliente del movimiento",
      "type": "string"
    },
    "reference": {
      "description": "Forma de pago",
      "type": "string"
    },
    "stock_after": {
      "description": "Stock resultante despu\u00e9s del movimiento",
      "type": "number"
    },
    "stock_apply_error": {
      "description": "\u00daltimo error al aplicar el stock de este movimiento (vac\u00edo si se aplic\u00f3 bien).",
      "type": "string"
    },
    "stock_apply_state": {
      "description": "Estado de la aplicaci\u00f3n del stock: pending (se va a escribir/ya se escribi\u00f3 el producto, falta la marca), applied o failed. Movimientos hist\u00f3ricos no lo tienen.",
      "enum": [
        "pending",
        "applied",
        "failed"
      ],
      "type": "string"
    },
    "stock_before": {
      "description": "Stock del producto justo antes de aplicar este movimiento (permite reintentar sin aplicar dos veces).",
      "type": "number"
    },
    "stock_applied": {
      "default": false,
      "description": "Marca si el efecto de este movimiento sobre el stock del producto ya fue aplicado (control de idempotencia, exactamente-una-vez).",
      "type": "boolean"
    },
    "stock_apply_error": {
      "description": "\u00daltimo error al aplicar el stock de este movimiento (vac\u00edo si se aplic\u00f3 bien).",
      "type": "string"
    },
    "stock_apply_state": {
      "description": "Estado de la aplicaci\u00f3n del stock: pending (se va a escribir/ya se escribi\u00f3 el producto, falta la marca), applied o failed. Movimientos hist\u00f3ricos no lo tienen.",
      "enum": [
        "pending",
        "applied",
        "failed"
      ],
      "type": "string"
    },
    "stock_before": {
      "description": "Stock del producto justo antes de aplicar este movimiento (permite reintentar sin aplicar dos veces).",
      "type": "number"
    },
    "stock_pending_at": {
      "description": "Momento (ISO) en que se escribi\u00f3 la marca pending; permite probar que nadie m\u00e1s toc\u00f3 el producto antes de recuperar un movimiento.",
      "type": "string"
    },
    "total": {
      "description": "Total del movimiento (cantidad \u00d7 precio venta)",
      "type": "number"
    },
    "type": {
      "description": "Tipo de movimiento",
      "enum": [
        "entry",
        "exit",
        "return",
        "adjustment"
      ],
      "type": "string"
    },
    "unit_price": {
      "description": "Precio unitario de venta en este movimiento",
      "type": "number"
    }
  },
  "required": [
    "product_id",
    "type",
    "quantity",
    "business_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}