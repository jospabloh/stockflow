{
  "name": "Movement",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID del producto"
    },
    "product_name": {
      "type": "string",
      "description": "Nombre del producto (desnormalizado)"
    },
    "type": {
      "type": "string",
      "enum": [
        "entry",
        "exit",
        "return",
        "adjustment"
      ],
      "description": "Tipo de movimiento"
    },
    "quantity": {
      "type": "number",
      "description": "Cantidad"
    },
    "unit_price": {
      "type": "number",
      "description": "Precio unitario de venta en este movimiento"
    },
    "cost_price": {
      "type": "number",
      "description": "Precio de compra/costo unitario en el momento del movimiento"
    },
    "total": {
      "type": "number",
      "description": "Total del movimiento (cantidad \u00d7 precio venta)"
    },
    "reason": {
      "type": "string",
      "description": "Cliente del movimiento"
    },
    "reference": {
      "type": "string",
      "description": "Forma de pago"
    },
    "stock_after": {
      "type": "number",
      "description": "Stock resultante despu\u00e9s del movimiento"
    },
    "quotation_id": {
      "type": "string",
      "description": "ID de cotizaci\u00f3n relacionada"
    },
    "paid": {
      "type": "boolean",
      "default": false,
      "description": "Pago recibido efectivamente (solo aplica a salidas directas sin cotizaci\u00f3n)"
    },
    "stock_applied": {
      "type": "boolean",
      "default": false,
      "description": "True cuando el efecto de este movimiento sobre Product.stock ya fue aplicado. Garantiza aplicaci\u00f3n exactamente-una-vez e idempotencia (ver applyMovementStock)."
    },
    "business_id": {
      "type": "string",
      "description": "ID del negocio al que pertenece"
    }
  },
  "required": [
    "product_id",
    "type",
    "quantity",
    "business_id"
  ],
  "rls": {
    "create": {
      "business_id": "{{user.business_id}}"
    },
    "read": {
      "business_id": "{{user.business_id}}"
    },
    "update": {
      "business_id": "{{user.business_id}}"
    },
    "delete": {
      "business_id": "{{user.business_id}}"
    }
  }
}