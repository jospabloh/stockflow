{
  "name": "UtilityMovement",
  "type": "object",
  "properties": {
    "account_id": {
      "description": "ID de la cuenta/fuente de dinero",
      "type": "string"
    },
    "account_name": {
      "description": "Nombre de la cuenta (desnormalizado al momento del registro)",
      "type": "string"
    },
    "affects_petty_cash": {
      "default": false,
      "description": "Si el movimiento gener\u00f3 un espejo en Caja Chica",
      "type": "boolean"
    },
    "amount": {
      "description": "Monto del movimiento",
      "type": "number"
    },
    "business_id": {
      "description": "ID del negocio al que pertenece",
      "type": "string"
    },
    "description": {
      "description": "Descripci\u00f3n del movimiento",
      "type": "string"
    },
    "movement_date": {
      "description": "Fecha del movimiento",
      "format": "date",
      "type": "string"
    },
    "movement_type": {
      "description": "Tipo de movimiento: ingreso o egreso",
      "enum": [
        "income",
        "expense"
      ],
      "type": "string"
    },
    "notes": {
      "description": "Notas adicionales (opcional)",
      "type": "string"
    },
    "petty_cash_movement_id": {
      "description": "ID del PettyCashMovement asociado cuando affects_petty_cash=true",
      "type": "string"
    },
    "reference": {
      "description": "Referencia o folio (opcional)",
      "type": "string"
    },
    "registered_by": {
      "description": "Usuario que registr\u00f3 el movimiento",
      "type": "string"
    },
    "rubro_id": {
      "description": "ID del rubro seleccionado",
      "type": "string"
    },
    "rubro_kind": {
      "description": "Naturaleza del rubro al momento del registro",
      "enum": [
        "income",
        "expense"
      ],
      "type": "string"
    },
    "rubro_name": {
      "description": "Nombre del rubro (desnormalizado al momento del registro)",
      "type": "string"
    },
    "taken_by": {
      "description": "Nombre de quien dispuso del dinero (opcional)",
      "type": "string"
    },
    "invoiced": {
      "default": false,
      "description": "Si el movimiento fue facturado",
      "type": "boolean"
    }
  },
  "required": [
    "business_id",
    "movement_type",
    "amount",
    "movement_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}