{
  "name": "FundAccount",
  "type": "object",
  "properties": {
    "active": {
      "default": true,
      "description": "Si est\u00e1 disponible para usar",
      "type": "boolean"
    },
    "affects_petty_cash": {
      "default": false,
      "description": "Si los movimientos con esta cuenta descuentan/ingresan a Caja Chica",
      "type": "boolean"
    },
    "business_id": {
      "description": "ID del negocio al que pertenece",
      "type": "string"
    },
    "is_system": {
      "default": false,
      "description": "Indica si fue sembrada por el sistema como predeterminada",
      "type": "boolean"
    },
    "name": {
      "description": "Nombre de la cuenta o fuente de dinero (ej. Efectivo (Caja Chica), Tarjeta AFIRME)",
      "type": "string"
    }
  },
  "required": [
    "name",
    "business_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}