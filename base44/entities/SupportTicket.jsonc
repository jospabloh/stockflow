{
  "name": "SupportTicket",
  "type": "object",
  "description": "Ticket de soporte que un negocio (tenant) abre a la plataforma. Los mensajes del hilo viven en SupportTicketMessage.",
  "properties": {
    "business_id": { "type": "string", "description": "ID del negocio que abrió el ticket" },
    "business_name": { "type": "string", "description": "Nombre del negocio (denormalizado)" },
    "subject": { "type": "string", "description": "Asunto del ticket" },
    "description": { "type": "string", "description": "Descripción inicial del problema" },
    "category": { "type": "string", "enum": ["billing", "technical", "account", "inventory", "sales", "feature_request", "other"], "default": "other", "description": "Categoría. 'feature_request' = solicitud de función/mejora (SLA 3-5 días hábiles); el resto son incidentes/problemas (SLA 24-48 hrs)." },
    "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"], "default": "normal", "description": "Prioridad" },
    "status": { "type": "string", "enum": ["open", "in_progress", "waiting_customer", "resolved", "closed"], "default": "open", "description": "Estado del ticket" },
    "created_by_id": { "type": "string", "description": "ID del usuario que lo creó" },
    "created_by_email": { "type": "string", "description": "Email del creador" },
    "assigned_to": { "type": "string", "description": "Email del agente de soporte asignado (owner)" },
    "first_response_at": { "type": "string", "format": "date-time", "description": "Primera respuesta del soporte" },
    "resolved_at": { "type": "string", "format": "date-time", "description": "Cuándo se resolvió" },
    "closed_at": { "type": "string", "format": "date-time", "description": "Cuándo se cerró" },
    "last_message_at": { "type": "string", "format": "date-time", "description": "Último mensaje en el hilo" },
    "last_message_by_role": { "type": "string", "enum": ["owner", "tenant"], "description": "Quién envió el último mensaje" },
    "messages_count": { "type": "number", "default": 0, "description": "Número de mensajes en el hilo" },
    "unread_for_owner": { "type": "boolean", "default": true, "description": "Hay mensajes sin leer para el soporte" },
    "unread_for_tenant": { "type": "boolean", "default": false, "description": "Hay mensajes sin leer para el negocio" },
    "metadata": { "type": "object", "description": "Datos adicionales" },
    "ai_brief": { "type": "object", "description": "Brief estructurado generado por el asistente BA/PO durante el intake (features: historia de usuario + criterios de aceptación + alcance; incidencias: pasos de reproducción + esperado/actual + severidad + impacto). El mismo contenido también viaja en Markdown dentro de description/body, así que el ticket es legible aunque este campo no esté desplegado." }
  },
  "required": ["business_id", "subject"],
  "rls": {
    "create": {
      "user_condition": { "role": "admin" }
    },
    "read": {
      "$or": [
        { "data.business_id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "user_condition": { "role": "admin" }
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}
