{
  "name": "TenantRule",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID del negocio al que pertenece esta regla"
    },
    "rule_key": {
      "type": "string",
      "description": "Identificador \u00fanico de la regla (ej: cash_sales_to_petty_cash)"
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Si la regla est\u00e1 activa para este tenant"
    },
    "config_json": {
      "type": "object",
      "description": "Configuraci\u00f3n adicional espec\u00edfica de la regla en formato JSON"
    },
    "notes": {
      "type": "string",
      "description": "Notas administrativas sobre el motivo y contexto de la regla"
    },
    "rule_scope": {
      "type": "string",
      "description": "\u00c1mbito de la regla (siempre: tenant)"
    },
    "source": {
      "type": "string",
      "description": "Origen de la regla (platform_admin)"
    },
    "created_by": {
      "type": "string",
      "description": "Email del administrador que cre\u00f3 la regla"
    },
    "updated_by": {
      "type": "string",
      "description": "Email del administrador que actualiz\u00f3 la regla por \u00faltima vez"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Si la regla fue archivada (soft delete)"
    },
    "last_applied_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que la regla fue aplicada"
    }
  },
  "required": [
    "business_id",
    "rule_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}